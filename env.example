# Local-only example. Do not place real values here or commit a populated .env file.
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_BASE_URL=https://api-sandbox.duitku.com
DUITKU_CALLBACK_URL=https://example.invalid/functions/v1/duitku-callback
DUITKU_RETURN_URL=https://example.invalid/payment-return
ALLOWED_ORIGIN=http://localhost:3000

# Supabase local runtime normally supplies SUPABASE_URL, SUPABASE_ANON_KEY,
# and SUPABASE_SERVICE_ROLE_KEY. Never expose the service role key to a client.
